** sch_path: /home/paaji/Sky130_prj/cim_logic_tb.sch
**.subckt cim_logic_tb
xarr VDD WL1 RWL1 BL BLb WL2 RWL2 RBL 0 row_2cell
xh VDD SAE OUTNH OUTPH VREFH RBL 0 strongarm
xl VDD SAE OUTNL OUTPL VREFL RBL 0 strongarm
xlh VDD OUTNH OUT_NOR OUT_OR OUTPH 0 sr_latch
xll VDD OUTNL OUT_NAND OUT_AND OUTPL 0 sr_latch
xx VDD OUT_OR OUT_XNOR OUT_NAND 0 nand2
xi VDD OUT_XNOR OUT_XOR 0 inv
XM1 RBL PREB VDD VDD sky130_fd_pr__pfet_01v8 L=0.15 W=2 nf=1 ad=0.58 as=0.58 pd=4.58 ps=4.58 nrd=0.145 nrs=0.145 sa=0 sb=0 sd=0
+ mult=1
C1 RBL 0 200f
V1 VDD 0 1.8
V2 VREFH 0 1.61
V3 VREFL 0 1.24
V4 WL1 0 PULSE(0 1.8 1n 50p 50p 0.95n 10n)
V5 WL2 0 PULSE(0 1.8 3n 50p 50p 0.95n 10n)
V6 PREB 0 PULSE(0 1.8 5n 50p 50p 1.45n 10n)
V7 RWL1 0 PULSE(0 1.8 5.2n 50p 50p 0.65n 10n)
V8 RWL2 0 PULSE(0 1.8 5.2n 50p 50p 0.65n 10n)
V9 SAE 0 PULSE(0 1.8 5.9n 50p 50p 0.45n 10n)
V10 BL 0 PWL(0 0 10.5n 0 10.55n 1.8 12.5n 1.8 12.55n 0 22.5n 0 22.55n 1.8 40n 1.8)
V11 BLb 0 PWL(0 1.8 10.5n 1.8 10.55n 0 12.5n 0 12.55n 1.8 22.5n 1.8 22.55n 0 40n 0)
**** begin user architecture code


.lib /usr/local/share/pdk/sky130A/libs.tech/ngspice/sky130.lib.spice ss
.ic v(xarr.x1.q)=0 v(xarr.x1.qb)=1.8 v(xarr.x2.q)=0 v(xarr.x2.qb)=1.8 v(rbl)=1.8
.tran 5p 40n uic
.control
run
meas tran v00 FIND v(rbl) AT=5.9n
meas tran v10 FIND v(rbl) AT=15.9n
meas tran v01 FIND v(rbl) AT=25.9n
meas tran v11 FIND v(rbl) AT=35.9n
meas tran and0 FIND v(out_and) AT=9.5n
meas tran and1 FIND v(out_and) AT=19.5n
meas tran and2 FIND v(out_and) AT=29.5n
meas tran and3 FIND v(out_and) AT=39.5n
meas tran nor0 FIND v(out_nor) AT=9.5n
meas tran nor1 FIND v(out_nor) AT=19.5n
meas tran nor2 FIND v(out_nor) AT=29.5n
meas tran nor3 FIND v(out_nor) AT=39.5n
meas tran xor0 FIND v(out_xor) AT=9.5n
meas tran xor1 FIND v(out_xor) AT=19.5n
meas tran xor2 FIND v(out_xor) AT=29.5n
meas tran xor3 FIND v(out_xor) AT=39.5n
plot v(xarr.x1.q)+12 v(xarr.x2.q)+10 v(sae)+8 v(out_and)+6 v(out_nor)+4 v(out_xor)+2 v(rbl)
set hcopydevtype=svg
hardcopy step5_cim_logic_ss.svg v(xarr.x1.q)+12 v(xarr.x2.q)+10 v(sae)+8 v(out_and)+6 v(out_nor)+4 v(out_xor)+2 v(rbl)
.endc


